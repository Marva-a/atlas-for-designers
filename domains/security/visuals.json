}],"w6-4":[{"k":"hub","t":"Ways in, part 2","c":["Threat vectors"],"s":[["Endpoints","phones, laptops, servers"],["Supply chain","managed service, logistics and SaaS providers"],["People","impersonation, contractors, visitors"],["IoT and OT","cameras, sensors, printers, industrial systems"],["Physical","malicious USB, locks, access passes"],["Signals","Bluetooth, RF, NFC"]]}],"w7-1":[{"k":"compare","t":"Three kinds of weak door","cols":[{"h":"Unsupported product","items":["An old lock nobody makes keys for"]},{"h":"Shadow IT","items":["A door the landlord doesn’t know exists"]},{"h":"Hardcoded secret","items":["A key taped next to the lock"]}]},{"k":"flow","t":"A race condition: time of check, time of use","s":[["Time of check","the system checks the file is safe","good"],{"l":"Time of use","d":"it uses a file that is no longer what it checked","tone":"bad","via":"in the gap, something swaps the file","dash":true}]}],"w7-2":[{"k":"hub","t":"The phishing family","c":["Tricking a person"],"s":[["Phishing","broad, by email"],["Spear phishing","aimed at one person"],["Whaling","aimed at executives"],["Smishing","by SMS"],["Vishing","by voice"],["Quishing","by QR code"]]}],"w7-3":[{"k":"compare","t":"Brute force or password spraying","cols":[{"h":"Brute force","items":["Many passwords","Against one account","Trips account lockout"]},{"h":"Password spraying","tone":"warn","items":["One common password","Against many accounts","Stays under lockout limits"]}]}],"w7-4":[{"k":"flow","t":"Why prompt injection works","s":[["Someone hides an instruction in content"],["The model reads it, along with your request"],["It cannot reliably tell instructions from data","","warn"],["It may follow the hidden one","","bad"]]}],"w8-1":[{"k":"compare","t":"Ways to separate systems","cols":[{"h":"Logical segmentation","items":["Same hardware, separated by configuration","For example, VLANs"]},{"h":"Physical segmentation","items":["Separate hardware for each zone"]},{"h":"Air-gapped","items":["No network connection to the outside at all"]}]}],"w8-2":[{"k":"hub","t":"What to weigh when choosing an architecture","c":["The choice"],"s":["Availability and resilience","Ease of recovery","Cost","Scalability","Data sovereignty","Responsibility and ownership","Power and compute","Risk"]}],"w8-4":[{"k":"compare","t":"When the lock loses power","cols":[{"h":"Fail-closed","items":["Stays locked","Safer for confidentiality","Can block legitimate use"]},{"h":"Fail-open","items":["Opens","Keeps things available","Lets everything through"]}]}],"w9-1":[{"k":"compare","t":"Data in three states","cols":[{"h":"At rest","items":["Money in the vault","Stored on disks, databases, backups","Full-disk, file and database encryption"]},{"h":"In transit","items":["Money in the armored truck","Moving across a network","Transport encryption such as TLS"]},{"h":"In use","tone":"warn","items":["Money on the counter being counted","Being processed in memory","Hardest to protect"]}]},{"k":"compare","t":"Ways to protect a value","cols":[{"h":"Masking","items":["Hide part of it: •••• 4821"]},{"h":"Tokenization","items":["Swap it for a random token; the real value sits in a separate vault"]},{"h":"Hashing","items":["A one-way digest"]},{"h":"Encryption","items":["Needs a key to read"]}]}],"w9-2":[{"k":"flow","t":"The data life cycle","s":["Creation","Management","Distribution","Retention","Disposal"]},{"k":"compare","t":"Who does what with data","cols":[{"h":"Owner","items":["Accountable","Decides classification"]},{"h":"Custodian","items":["Implements and maintains the technical controls"]},{"h":"Steward","items":["Looks after quality and proper use"]},{"h":"Controller","items":["Decides why and how personal data is processed"]}]}],"w9-3":[{"k":"scale","t":"Recovery sites","from":"Cheaper, slower to use","to":"Costlier, ready at once","s":[["Cold","an empty room with power and a lease"],["Warm","furniture, but needs setup"],["Hot","furnished and stocked: walk in"]]}],"w9-4":[{"k":"compare","t":"Two reliability numbers","cols":[{"h":"MTBF","items":["How long it tends to work before breaking","Higher is better"]},{"h":"MTTR","items":["How long it takes to fix","Lower is better"]}]}],"w10-1":[{"k":"compare","t":"Guards with different jobs","cols":[{"h":"Firewall","items":["Checks addresses and ports"]},{"h":"WAF","items":["Reads the content of web requests"]},{"h":"IDS","items":["A camera with an alarm","Detects and alerts"]},{"h":"IPS","items":["A guard who can step in","Detects and blocks"]}]},{"k":"flow","t":"Network access control with 802.1X","s":[["A device connects","the supplicant"],["The switch or access point","the authenticator"],["A RADIUS server checks it","identity and, often, posture"],["Allowed in, or kept out","","good"]]}],"w10-2":[{"k":"scale","t":"From known bad to suspicious behaviour","from":"Known threats","to":"Unknown behaviour","s":[["Antivirus","photos of known criminals"],["EDR","a detective watching behaviour, able to step in"],["XDR","the same, across more sources"]]},{"k":"compare","t":"Allow list or block list","cols":[{"h":"Allow list","tone":"good","items":["A guest list: not on it, not in","Stricter"]},{"h":"Block list","items":["A list of who is banned","Anything new gets through"]}]}],"w10-3":[{"k":"hub","t":"Deception: bait that only an attacker would touch","c":["Deception"],"s":[["Honeypot","a decoy system"],["Honeynet","a decoy network"],["Honeyfile","a decoy file"],["Honeytoken","a decoy credential or record"],["Canary account","a decoy account"]]}],"w10-4":[{"k":"flow","t":"An asset’s life","s":[["Plan and scope"],["Acquire"],["Assign","an owner is accountable"],["Monitor and track"],["Dispose","sanitize, then get a certificate of destruction"]],"n":"Like clearing out the glove compartment before selling the company car."}],"w11-1":[{"k":"cycle","t":"Vulnerability management","s":[["Identify","scan, review code, check cloud settings"],["Prioritize","severity plus context"],["Remediate","patch, reconfigure, compensate or accept"],["Verify","usually by rescanning"],["Report"]],"b":"Then inspect again"},{"k":"matrix","t":"When the scanner is wrong","x":["A real problem","No problem"],"y":["Scanner flags it","Scanner is silent"],"c":[[["True positive","good"],["False positive","warn"]],[["False negative: missed","bad"],["True negative","good"]]]}],"w11-2":[{"k":"flow","t":"From sensors to response","s":[["Sources","systems, apps, network devices"],["Log aggregation"],["SIEM","the security desk where everything meets"],["Tuned alerts","not every opened window"],["SOAR","runs the playbook"]]}],"w11-4":[{"k":"compare","t":"Access control models","cols":[{"h":"Role-based","items":["Staff uniforms: nurses get nurse access"]},{"h":"Discretionary","items":["Your diary: the owner decides"]},{"h":"Mandatory","items":["Military clearance: the owner cannot change it"]},{"h":"Rule-based","items":["Conditions apply, like firewall rules"]},{"h":"Just-in-time","items":["A key checked out for one hour"]}],"n":"Enforcement happens on the server for every request. Hiding a button changes what people see, not what they can do."}],"w12-1":[{"k":"compare","t":"Automation and orchestration","cols":[{"h":"Automation","items":["A dishwasher","One job, the same way every time"]},{"h":"Orchestration","items":["The kitchen manager","Coordinates many jobs so the whole meal comes together"]}],"n":"Guardrails keep automation from doing harm quickly and at scale."}],"w12-3":[{"k":"hub","t":"Reconstructing what happened","c":["The incident"],"s":[["Logs","endpoint, network, application, authentication"],["Network data","NetFlow, packet captures"],["Vulnerability scans"],["Metadata","email headers, file details"],["Physical records","badges, surveillance footage"],["Security tool dashboards"]]}],"w12-4":[{"k":"scale","t":"Order of volatility: collect the most fleeting first","from":"Gone soonest","to":"Lasts longest","s":[["CPU registers and cache"],["Memory","routing and process tables"],["Temporary files"],["Disk"],["Remote logs"],["Archived media"]]},{"k":"flow","t":"Work from a copy","s":[["Original evidence","left untouched"],["Bit-level copy","hashed when made"],["Investigate the copy"],["Hashes still match","the evidence was not changed","good"]]}],"w13-1":[{"k":"compare","t":"Four kinds of governance document","cols":[{"h":"Policy","items":["What must happen","All staff must wear seatbelts"]},{"h":"Standard","items":["Measurable requirements","The seatbelt must meet this rating"]},{"h":"Procedure","items":["The steps","Buckle it this way"]},{"h":"Guideline","items":["Recommended advice","Consider adjusting your seat first"]}]}],"w13-2":[{"k":"compare","t":"Four ways to respond to a risk","cols":[{"h":"Mitigate","items":["Lock the doors"]},{"h":"Transfer","items":["Buy insurance"]},{"h":"Avoid","items":["Move out of the flood zone"]},{"h":"Accept","items":["Live with the small risks"]}]},{"k":"flow","t":"Annualized loss, worked through","s":[["SLE","each loss costs $10,000"],["× ARO","it happens 0.5 times a year"],["= ALE","$5,000 a year","warn"]]}],"w13-3":[{"k":"flow","t":"Bringing in a vendor","s":[["Ask","RFI for information, RFP for proposals, RFQ for quotes"],["Due diligence","check references and conflicts of interest"],["Agree","MSA, SOW, SLA, NDA"],["Monitor","right to audit, service-level monitoring"]]},{"k":"compare","t":"Which agreement does what","cols":[{"h":"MSA","items":["The overall terms for future work"]},{"h":"SOW","items":["The specific work and deliverables"]},{"h":"SLA","items":["Measurable service levels"]},{"h":"NDA","items":["Keep shared information secret"]}]}],"w13-4":[{"k":"hub","t":"Rights people have over their data","c":["The data subject"],"s":["Right to be forgotten","Opt in or opt out","Data correction","Restrict processing","Prevent processing"]},{"k":"compare","t":"Controller and processor","cols":[{"h":"Controller","items":["Decides why and how personal data is processed"]},{"h":"Processor","items":["Processes it on the controller’s behalf"]}]}],"w13-5":[{"k":"scale","t":"How much the tester knows","from":"Has the floor plans","to":"Has nothing","s":[["Known environment"],["Partially known environment"],["Unknown environment"]]},{"k":"compare","t":"Audit or penetration test","cols":[{"h":"Audit","items":["A health check of your records","Do the controls exist and work?"]},{"h":"Penetration test","items":["A friendly burglar, hired to try the doors","Always with written rules of engagement"]}]}],"w13-6":[{"k":"cycle","t":"Awareness that sticks","s":[["Onboarding","when someone joins"],["Ongoing","regular, specific practice"],["Measure","metrics and reports"],["Targeted or corrective","for the people and topics that need it"]],"b":"Then back to ongoing practice, with feedback"}]}}